# ============================================
# ByteStreams Intranet — Environment Config
# ============================================

# --- App ---
PUBLIC_BASE_URL=https://bytestreams.info

# --- Supabase ---
# Anon (public) key — safe to use in the browser. RLS enforces access control.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>
# Service role key — server-side only, never sent to browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard>

# Optional: dedicate portal-admin to a different Supabase project.
# If set, both variables below must be set together.
PORTAL_SUPABASE_URL=https://<portal-project-ref>.supabase.co
PORTAL_SUPABASE_SERVICE_ROLE_KEY=<portal-service-role-key>

# --- Portal Admin ---
# Optional for invite/resend-invite email delivery from portal-admin.
# If omitted, customers can still be created but invite email send is skipped.
RESEND_API_KEY=<resend-api-key>

# --- Google Calendar (per-user OAuth 2.0) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# with the Calendar API enabled. Authorized redirect URI must exactly match
# GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://bytestreams.info/calendar/oauth/callback
