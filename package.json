{
  "name": "bytestreams-intranet",
  "version": "0.1.0",
  "private": true,
  "description": "ByteStreams LLC Intranet — SSO-gated internal platform at bytestreams.info",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "sync:call-script": "cp ../dialtone_sm/DialTone_Cold_Call_Template.md src/lib/server/prompts/DialTone_Cold_Call_Template.md",
    "update:call-script": "bash developer/update-call-script.sh",
    "portal:add-account": "node developer/add-portal-account.mjs",
    "portal:remove-customer": "node developer/remove-portal-customer.mjs",
    "dial:bridge": "node developer/kdeconnect-bridge.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.4",
    "@sveltejs/adapter-cloudflare": "^5.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.88.0"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "~6.1.21",
    "@fullcalendar/interaction": "~6.1.21",
    "@fullcalendar/list": "~6.1.21",
    "@fullcalendar/timegrid": "~6.1.21",
    "@supabase/supabase-js": "^2.110.7",
    "htmlparser2": "^12.0.0",
    "jose": "^6.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
